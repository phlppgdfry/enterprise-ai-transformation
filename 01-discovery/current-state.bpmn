<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AsIs_defs" targetNamespace="https://wendelkaai.example/bpmn">
<bpmn:collaboration id="AsIs_collab"><bpmn:participant id="AsIs_pool" name="Doc desk: inbound freight documents (as-is)" processRef="AsIs"/></bpmn:collaboration>
<bpmn:process id="AsIs" name="Doc desk: inbound freight documents (as-is)" isExecutable="false"><bpmn:laneSet id="AsIs_lanes"><bpmn:lane id="L_ship" name="Shipper / agent"><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_desk" name="Doc desk clerk"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ops" name="Operations and customs"><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="s1" name="Document e-mail received"><bpmn:outgoing>AsIs_f0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Find the shipment and the document type"><bpmn:incoming>AsIs_f0</bpmn:incoming><bpmn:incoming>AsIs_f5</bpmn:incoming><bpmn:outgoing>AsIs_f1</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g1" name="Set complete?"><bpmn:incoming>AsIs_f1</bpmn:incoming><bpmn:outgoing>AsIs_f2</bpmn:outgoing><bpmn:outgoing>AsIs_f3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t2" name="Chase missing documents"><bpmn:incoming>AsIs_f3</bpmn:incoming><bpmn:outgoing>AsIs_f4</bpmn:outgoing></bpmn:task><bpmn:task id="t3" name="Send missing document"><bpmn:incoming>AsIs_f4</bpmn:incoming><bpmn:outgoing>AsIs_f5</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Key all fields into the TMS"><bpmn:incoming>AsIs_f2</bpmn:incoming><bpmn:incoming>AsIs_f9</bpmn:incoming><bpmn:outgoing>AsIs_f6</bpmn:outgoing></bpmn:task><bpmn:task id="t5" name="Compare with booking and other documents"><bpmn:incoming>AsIs_f6</bpmn:incoming><bpmn:outgoing>AsIs_f7</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g2" name="Discrepancy?"><bpmn:incoming>AsIs_f7</bpmn:incoming><bpmn:outgoing>AsIs_f8</bpmn:outgoing><bpmn:outgoing>AsIs_f10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t6" name="Ask for a corrected document"><bpmn:incoming>AsIs_f8</bpmn:incoming><bpmn:outgoing>AsIs_f9</bpmn:outgoing></bpmn:task><bpmn:task id="t7" name="Plan transport and prepare customs declaration"><bpmn:incoming>AsIs_f10</bpmn:incoming><bpmn:outgoing>AsIs_f11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e1" name="Shipment ready"><bpmn:incoming>AsIs_f11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AsIs_f0" sourceRef="s1" targetRef="t1"/><bpmn:sequenceFlow id="AsIs_f1" sourceRef="t1" targetRef="g1"/><bpmn:sequenceFlow id="AsIs_f2" sourceRef="g1" targetRef="t4" name="yes"/><bpmn:sequenceFlow id="AsIs_f3" sourceRef="g1" targetRef="t2" name="no"/><bpmn:sequenceFlow id="AsIs_f4" sourceRef="t2" targetRef="t3"/><bpmn:sequenceFlow id="AsIs_f5" sourceRef="t3" targetRef="t1"/><bpmn:sequenceFlow id="AsIs_f6" sourceRef="t4" targetRef="t5"/><bpmn:sequenceFlow id="AsIs_f7" sourceRef="t5" targetRef="g2"/><bpmn:sequenceFlow id="AsIs_f8" sourceRef="g2" targetRef="t6" name="yes"/><bpmn:sequenceFlow id="AsIs_f9" sourceRef="t6" targetRef="t4"/><bpmn:sequenceFlow id="AsIs_f10" sourceRef="g2" targetRef="t7" name="no"/><bpmn:sequenceFlow id="AsIs_f11" sourceRef="t7" targetRef="e1"/></bpmn:process>
<bpmndi:BPMNDiagram id="AsIs_diagram"><bpmndi:BPMNPlane id="AsIs_plane" bpmnElement="AsIs_collab"><bpmndi:BPMNShape id="AsIs_pool_di" bpmnElement="AsIs_pool" isHorizontal="true"><dc:Bounds x="60" y="0" width="1600" height="390"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_ship_di" bpmnElement="L_ship" isHorizontal="true"><dc:Bounds x="90" y="0" width="1570" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_desk_di" bpmnElement="L_desk" isHorizontal="true"><dc:Bounds x="90" y="130" width="1570" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_ops_di" bpmnElement="L_ops" isHorizontal="true"><dc:Bounds x="90" y="260" width="1570" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="157" y="177" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="280" y="160" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="490" y="170" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="620" y="160" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="620" y="30" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="790" y="160" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="960" y="160" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1170" y="170" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1300" y="30" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1300" y="290" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1517" y="307" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AsIs_f0_di" bpmnElement="AsIs_f0"><di:waypoint x="193" y="195"/><di:waypoint x="280" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f1_di" bpmnElement="AsIs_f1"><di:waypoint x="410" y="195"/><di:waypoint x="490" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f2_di" bpmnElement="AsIs_f2"><di:waypoint x="515" y="220"/><di:waypoint x="515" y="246"/><di:waypoint x="855" y="246"/><di:waypoint x="855" y="230"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f3_di" bpmnElement="AsIs_f3"><di:waypoint x="540" y="195"/><di:waypoint x="620" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f4_di" bpmnElement="AsIs_f4"><di:waypoint x="685" y="160"/><di:waypoint x="685" y="100"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f5_di" bpmnElement="AsIs_f5"><di:waypoint x="685" y="30"/><di:waypoint x="685" y="8"/><di:waypoint x="345" y="8"/><di:waypoint x="345" y="160"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f6_di" bpmnElement="AsIs_f6"><di:waypoint x="920" y="195"/><di:waypoint x="960" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f7_di" bpmnElement="AsIs_f7"><di:waypoint x="1090" y="195"/><di:waypoint x="1170" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f8_di" bpmnElement="AsIs_f8"><di:waypoint x="1220" y="195"/><di:waypoint x="1280" y="195"/><di:waypoint x="1280" y="65"/><di:waypoint x="1300" y="65"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f9_di" bpmnElement="AsIs_f9"><di:waypoint x="1365" y="30"/><di:waypoint x="1365" y="8"/><di:waypoint x="855" y="8"/><di:waypoint x="855" y="160"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f10_di" bpmnElement="AsIs_f10"><di:waypoint x="1220" y="195"/><di:waypoint x="1280" y="195"/><di:waypoint x="1280" y="325"/><di:waypoint x="1300" y="325"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AsIs_f11_di" bpmnElement="AsIs_f11"><di:waypoint x="1430" y="325"/><di:waypoint x="1517" y="325"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
