<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ToBe_defs" targetNamespace="https://wendelkaai.example/bpmn">
<bpmn:collaboration id="ToBe_collab"><bpmn:participant id="ToBe_pool" name="Doc desk: inbound freight documents (to-be, with the pilot)" processRef="ToBe"/></bpmn:collaboration>
<bpmn:process id="ToBe" name="Doc desk: inbound freight documents (to-be, with the pilot)" isExecutable="false"><bpmn:laneSet id="ToBe_lanes"><bpmn:lane id="L_sys" name="Document pipeline"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_desk" name="Doc desk clerk"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_ops" name="Operations and customs"><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="s1" name="Document e-mail received"><bpmn:outgoing>ToBe_f0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Classify and extract fields"><bpmn:incoming>ToBe_f0</bpmn:incoming><bpmn:outgoing>ToBe_f1</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Validate (V01-V14) incl. cross-document checks"><bpmn:incoming>ToBe_f1</bpmn:incoming><bpmn:outgoing>ToBe_f2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g1" name="Route"><bpmn:incoming>ToBe_f2</bpmn:incoming><bpmn:outgoing>ToBe_f3</bpmn:outgoing><bpmn:outgoing>ToBe_f4</bpmn:outgoing><bpmn:outgoing>ToBe_f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t3" name="Post record to the TMS"><bpmn:incoming>ToBe_f3</bpmn:incoming><bpmn:incoming>ToBe_f6</bpmn:incoming><bpmn:outgoing>ToBe_f7</bpmn:outgoing><bpmn:outgoing>ToBe_f8</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Check only the flagged fields, confirm or correct"><bpmn:incoming>ToBe_f4</bpmn:incoming><bpmn:outgoing>ToBe_f6</bpmn:outgoing></bpmn:task><bpmn:task id="t5" name="Handle by hand (not a freight document or type unsure)"><bpmn:incoming>ToBe_f5</bpmn:incoming><bpmn:outgoing>ToBe_f9</bpmn:outgoing></bpmn:task><bpmn:task id="t6" name="5% random audit of straight-through documents"><bpmn:incoming>ToBe_f7</bpmn:incoming><bpmn:outgoing>ToBe_f10</bpmn:outgoing></bpmn:task><bpmn:task id="t7" name="Plan transport and prepare customs declaration"><bpmn:incoming>ToBe_f8</bpmn:incoming><bpmn:incoming>ToBe_f9</bpmn:incoming><bpmn:outgoing>ToBe_f11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e1" name="Shipment ready"><bpmn:incoming>ToBe_f11</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="e2" name="Audit result logged"><bpmn:incoming>ToBe_f10</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="ToBe_f0" sourceRef="s1" targetRef="t1"/><bpmn:sequenceFlow id="ToBe_f1" sourceRef="t1" targetRef="t2"/><bpmn:sequenceFlow id="ToBe_f2" sourceRef="t2" targetRef="g1"/><bpmn:sequenceFlow id="ToBe_f3" sourceRef="g1" targetRef="t3" name="auto"/><bpmn:sequenceFlow id="ToBe_f4" sourceRef="g1" targetRef="t4" name="review"/><bpmn:sequenceFlow id="ToBe_f5" sourceRef="g1" targetRef="t5" name="manual"/><bpmn:sequenceFlow id="ToBe_f6" sourceRef="t4" targetRef="t3"/><bpmn:sequenceFlow id="ToBe_f7" sourceRef="t3" targetRef="t6"/><bpmn:sequenceFlow id="ToBe_f8" sourceRef="t3" targetRef="t7"/><bpmn:sequenceFlow id="ToBe_f9" sourceRef="t5" targetRef="t7"/><bpmn:sequenceFlow id="ToBe_f10" sourceRef="t6" targetRef="e2"/><bpmn:sequenceFlow id="ToBe_f11" sourceRef="t7" targetRef="e1"/></bpmn:process>
<bpmndi:BPMNDiagram id="ToBe_diagram"><bpmndi:BPMNPlane id="ToBe_plane" bpmnElement="ToBe_collab"><bpmndi:BPMNShape id="ToBe_pool_di" bpmnElement="ToBe_pool" isHorizontal="true"><dc:Bounds x="60" y="0" width="1430" height="390"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_sys_di" bpmnElement="L_sys" isHorizontal="true"><dc:Bounds x="90" y="0" width="1400" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_desk_di" bpmnElement="L_desk" isHorizontal="true"><dc:Bounds x="90" y="130" width="1400" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_ops_di" bpmnElement="L_ops" isHorizontal="true"><dc:Bounds x="90" y="260" width="1400" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="157" y="47" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="280" y="30" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="450" y="30" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="660" y="40" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="960" y="30" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="790" y="160" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="960" y="160" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1130" y="160" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1130" y="290" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1347" y="307" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1347" y="177" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="ToBe_f0_di" bpmnElement="ToBe_f0"><di:waypoint x="193" y="65"/><di:waypoint x="280" y="65"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f1_di" bpmnElement="ToBe_f1"><di:waypoint x="410" y="65"/><di:waypoint x="450" y="65"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f2_di" bpmnElement="ToBe_f2"><di:waypoint x="580" y="65"/><di:waypoint x="660" y="65"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f3_di" bpmnElement="ToBe_f3"><di:waypoint x="710" y="65"/><di:waypoint x="960" y="65"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f4_di" bpmnElement="ToBe_f4"><di:waypoint x="710" y="65"/><di:waypoint x="770" y="65"/><di:waypoint x="770" y="195"/><di:waypoint x="790" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f5_di" bpmnElement="ToBe_f5"><di:waypoint x="710" y="65"/><di:waypoint x="940" y="65"/><di:waypoint x="940" y="195"/><di:waypoint x="960" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f6_di" bpmnElement="ToBe_f6"><di:waypoint x="920" y="195"/><di:waypoint x="940" y="195"/><di:waypoint x="940" y="65"/><di:waypoint x="960" y="65"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f7_di" bpmnElement="ToBe_f7"><di:waypoint x="1090" y="65"/><di:waypoint x="1110" y="65"/><di:waypoint x="1110" y="195"/><di:waypoint x="1130" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f8_di" bpmnElement="ToBe_f8"><di:waypoint x="1090" y="65"/><di:waypoint x="1110" y="65"/><di:waypoint x="1110" y="325"/><di:waypoint x="1130" y="325"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f9_di" bpmnElement="ToBe_f9"><di:waypoint x="1090" y="195"/><di:waypoint x="1110" y="195"/><di:waypoint x="1110" y="325"/><di:waypoint x="1130" y="325"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f10_di" bpmnElement="ToBe_f10"><di:waypoint x="1260" y="195"/><di:waypoint x="1347" y="195"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="ToBe_f11_di" bpmnElement="ToBe_f11"><di:waypoint x="1260" y="325"/><di:waypoint x="1347" y="325"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
